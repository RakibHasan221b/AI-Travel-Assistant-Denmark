# Phase 1
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Phase 4 (Reddit signal pipeline)
GROQ_API_KEY=

# Phase 8 RAG summaries AND Phase 11 Trip Planner (agent/crew.py) both use
# this. Required for the Trip Planner's real AI planning/narration — if
# unset, /trip-plan still works, but always answers with the deterministic
# fallback (real database places, no LLM-written recommendation).
OPENAI_API_KEY=
# Cheapest model confirmed (Aug 2026) to reliably follow tool calls with a
# tight max_tokens budget — see agent/crew.py's build_llm() for why the
# even-cheaper gpt-5-nano was tried and rejected. Optional, defaults to
# gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini
# Hard per-call output cap and hard per-request LLM-call-count cap — see
# agent/crew.py's MAX_AGENT_ITER comment for the full reasoning. Both
# optional, shown here at their code defaults.
OPENAI_MAX_OUTPUT_TOKENS=900
MAX_LLM_CALLS_PER_REQUEST=6

# Web enrichment (thin-data backfill, ingestion/web_enrichment.py) — free
# tier, no card required: https://serper.dev
SERPER_API_KEY=
